    "@hono/node-server": "^2.1.1",
    "@llamaindex/llama-cloud": "^2.15.0",
    "@mastra/core": "^1.64.0",
    "@mastra/duckdb": "^1.6.4",
    "@mastra/hono": "^1.7.6",
    "@mastra/libsql": "^1.22.3",
    "@mastra/loggers": "^1.3.1",
    "@mastra/memory": "^1.28.2",
    "@mastra/observability": "^1.17.5",
    "@mastra/pg": "^1.25.0",
    "@mastra/rag": "^1.3.5",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "^5.0.258",
    "better-auth": "catalog:",
