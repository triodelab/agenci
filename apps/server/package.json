{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./router": "./src/routers/index.ts",
    "./ws": "./src/lib/ws-protocol.ts",
    "./agent-behavior": "./src/mastra/agent-behavior.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --hot src/index.ts",
    "dev:mastra": "PORT=4111 mastra dev --dir src/mastra",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@agenci/auth": "workspace:*",
