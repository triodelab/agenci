# Hono + Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3004
WIDGET_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/agenci
PORT=3003
NODE_ENV=development

# Inngest Dev Server (docker compose service `inngest` on :8288)
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_IAM=
AWS_REGION=auto
AWS_BUCKET_NAME=
AWS_MARKDOWN_BUCKET=

# Mastra
# OPENAI_API_KEY=sk-...
