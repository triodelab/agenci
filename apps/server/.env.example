# Hono + Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3004
WIDGET_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/agenci
PORT=3003
NODE_ENV=development

# Inngest Dev Server (docker compose service `inngest` on :8288)
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# MinIO (docker compose service `minio` on :9000, console :9001)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=agenci
MINIO_SECRET_KEY=agenci_dev_secret
MINIO_REGION=us-east-1
MINIO_BUCKET=agenci-bucket

# Mastra
# OPENAI_API_KEY=sk-...
# Conversation memory (Observational Memory) uses DATABASE_URL — no extra config.
