# Copy to .env / .env.local and fill in.

# Kanonisk URL (JSON-LD, sitemap, robots). I produksjon: https://dittdomene.no
# NEXT_PUBLIC_APP_URL=https://agenci.no

# Vises i personvernerklæring (fullt selskapsnavn, org.nr., adresse).
# NEXT_PUBLIC_COMPANY_LEGAL_LINE="Agenci AS, org.nr. 123 456 789, Storgata 1, 0001 Oslo"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Optional: URL til widget.js som embed-snippet bruker (default er placeholder fra tidligere demo).
# NEXT_PUBLIC_WIDGET_EMBED_SCRIPT_URL=https://your-cdn.example.com/widget.js

# Optional: Base-URL for «Åpne widget» på Integrations (default http://localhost:3001).
# NEXT_PUBLIC_WIDGET_PREVIEW_ORIGIN=https://widget.example.com

# Development: åpner ProPlanGate for alle. Påvirker ikke /billing (der vises alltid Clerk med mindre
# NEXT_PUBLIC_HIDE_CLERK_BILLING_UI er satt). Sett til false i produksjon.
NEXT_PUBLIC_DEV_BYPASS_PREMIUM=true

# Optional: Pro i UI uten global bypass. Kombiner med CONVEX_DEV_TEAM_EMAILS på Convex for backend.
# NEXT_PUBLIC_TEAM_DEVELOPER_EMAILS="dev1@firma.no,dev2@firma.no"

# Optional: skjul ekte Clerk på /billing (plassholder) for ikke-team-e-post. Kun når du må (f.eks. CI
# uten Clerk Billing). Team-listen over ser fortsatt Clerk når dette er true.
# NEXT_PUBLIC_HIDE_CLERK_BILLING_UI=true

# Optional: Resend — kontaktskjema og nyhetsbrev sender til denne adressen når nøkkel er satt.
# https://resend.com — verifiser domene for «from» i produksjon.
# RESEND_API_KEY=re_...
# NOTIFY_TO_EMAIL=post@triodelab.no
# RESEND_FROM_EMAIL="Agenci <post@triodelab.no>"
