{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["../*"],
      "@workspace/ui/*": ["../../../packages/ui/src/*"]
    }
  },
  "include": [
    "./**/*.tsx",
    "../modules/landing/hero-stories.ts",
    "../modules/landing/remotion/**/*.tsx",
    "../modules/landing/ui/components/hero-conversation*.tsx",
    "../modules/landing/ui/components/product-demo*.tsx"
  ]
}
