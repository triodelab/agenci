# Copy to .env.local for `npx convex dev` where applicable.
# Many secrets are stored on the Convex deployment (Dashboard → Environment variables
# or `npx convex env set NAME value`). Same deployment must match NEXT_PUBLIC_CONVEX_URL
# in apps/web and apps/widget.

# ─── Convex CLI (lokalt) ───
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# ─── Clerk (sett på Convex-deployment — ikke bare i apps/web/.env) ───
# Issuer URL fra Clerk (JWT-mal «convex»). Obligatorisk for auth.config.ts.
# npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://<instans>.clerk.accounts.dev"
CLERK_JWT_ISSUER_DOMAIN=

# Samme som Clerk Secret Key i dashboard. Trengs for public/organizations.validate (widget)
# og Clerk API i http-ruter.
# npx convex env set CLERK_SECRET_KEY "sk_test_...."
CLERK_SECRET_KEY=

# Webhook-signering for POST /clerk-webhook (user sync + subscription.updated).
# Verdi fra Clerk → Webhooks → Signing secret.
# npx convex env set CLERK_WEBHOOK_SECRET "whsec_...."
CLERK_WEBHOOK_SECRET=

# ─── OpenAI (sett på Convex-deployment — obligatorisk for RAG + agent) ───
# Brukes av: embeddings (RAG), supportAgent, search-verktøyet, extractTextContent (PDF/bilde).
# npx convex env set OPENAI_API_KEY "sk-...."
OPENAI_API_KEY=

# ─── AWS (valgfritt — kun Voice / Vapi plugin med Secrets Manager) ───
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Abonnement / RAG / agent (data, ikke env) ───
# Agent-svar, filopplasting til knowledge base og «Enhance» krever rad i tabellen
# `subscriptions` med status "active" for org_id (Clerk organizationId).
# I produksjon: Clerk Billing + webhook subscription.updated mot
# https://<deployment>.convex.site/clerk-webhook
# I dev: legg inn manuelt i Convex Dashboard → Data → subscriptions, eller trigge webhook.
