# Copy to .env.local and fill in. Used by `npx convex dev` (see docs/CONVEX_CLERK_JWT.md).
# CLERK_JWT_ISSUER_DOMAIN = Issuer URL from Clerk (JWT template "convex" or Clerk dashboard).
CLERK_JWT_ISSUER_DOMAIN=

# Clerk Secret Key — må OGSÅ settes på Convex (Dashboard eller `npx convex env set CLERK_SECRET_KEY ...`)
# for actions som public/organizations.validate (widget). Ikke bare i Next.js .env.
# CLERK_SECRET_KEY=
# Convex CLI: set by `npx convex dev --configure` or Convex dashboard
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
