{
  "name": "agenci",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^20.19.25",
      "convex": "^1.31.2",
      "dotenv": "^17.2.3",
      "typescript": "^5",
      "zod": "^4.1.13"
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:widget": "npx turbo -F widget dev",
    "dev:web": "npx turbo -F web dev",
    "dev:backend": "npx turbo -F @agenci/backend dev",
    "dev:setup": "npx turbo -F @agenci/backend dev:setup"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.5.1",
    "@types/node": "catalog:",
    "turbo": "^2.7.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
