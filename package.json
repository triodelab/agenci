{
  "name": "agenci",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "lucide-react": "^1.27.0",
      "convex": "^1.39.1",
      "typescript": "^7.0.2",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.1",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "@orpc/tanstack-query": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-form": "^1.33.2",
      "hono": "^4.13.8",
      "@types/bun": "^1.4.2",
      "elysia": "^1.4.29"
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:fresh": "rm -rf apps/web/.next && turbo dev",
    "dev:web:clean": "rm -rf apps/web/.next && turbo dev --filter=web",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:widget": "turbo -F widget dev",
    "dev:web": "turbo -F web dev",
    "dev:dashboard": "turbo -F dashboard dev",
    "docker:down": "docker compose down",
    "dev:server": "bun --filter server dev",
    "verify": "bunx tsc --noEmit -p apps/web && bunx tsc --noEmit -p apps/widget && bun --filter dashboard check-types && bun --filter server check-types",
    "infra:up": "docker compose up -d postgres inngest minio minio-setup",
    "server:up": "docker compose up -d server postgres inngest minio minio-setup"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@agenci/config": "workspace:*",
    "prettier": "^3.5.1",
    "turbo": "^2.7.5",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.2"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@prisma/client",
    "@prisma/engines",
    "@swc/core",
    "bufferutil",
    "core-js",
    "core-js-pure",
    "esbuild",
    "lightningcss",
    "msgpackr-extract",
    "prisma",
    "protobufjs",
    "sharp",
    "utf-8-validate"
  ],
  "dependencies": {
    "@mastra/pg": "^1.25.0",
    "ai": "5"
  }
}
