{
	servers {
		# Cloudflare sits in front of both domains. Trust its edge only, so the
		# real visitor IP (CF-Connecting-IP) can't be spoofed by calling the
		# origin directly. Ranges: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Headers for every response on both domains.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), payment=(self), microphone=(self)"
		-Server
	}
}

app.agenci.no {
	import security
	encode zstd gzip
	# The dashboard is never shown inside someone else's page.
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}

	# API on the same origin as the dashboard (matches the Vite dev proxy).
	@api path /rpc /rpc/* /api/* /ws
	handle @api {
		# File uploads are capped at 50 MB in the server; allow a little overhead.
		request_body {
			max_size 60MB
		}
		reverse_proxy server:3003 {
			# One trustworthy client IP for rate limits (never the caller's own header).
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# Dashboard SPA: unknown paths fall back to index.html for client routing.
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}

# Chat widget (framed on customers' sites) and the embed script.
widget.agenci.no {
	import security
	encode zstd gzip
	# Framed on customers' sites, so no frame restrictions here.
	header Content-Security-Policy "object-src 'none'; base-uri 'self'"
	# The embed script has a fixed URL on customers' sites: keep caches short
	# so updates reach them within minutes (Cloudflare honours this).
	header /widget.iife.js Cache-Control "public, max-age=300"
	root * /srv/widget
	try_files {path} /index.html
	file_server
}
