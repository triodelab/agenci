# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public URLs
BETTER_AUTH_URL=https://app.agenci.no
CORS_ORIGIN=https://app.agenci.no
DASHBOARD_ORIGIN=https://app.agenci.no
WIDGET_ORIGIN=https://widget.agenci.no

# Generated secrets (openssl rand -hex 32)
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
MINIO_ACCESS_KEY=agenci
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET=agenci-bucket

# Third-party keys
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
LLAMA_API_KEY=
